# Sao chép thành .env.local khi chạy trên máy. Không đưa khóa thật lên GitHub.

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# API luận giải chạy trên Vercel; chỉ cần khóa nếu muốn dùng AI.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nếu trang tĩnh GitHub Pages gọi API trên Vercel:
# NEXT_PUBLIC_AI_API_URL=https://tuvilaso-online.vercel.app/api/interpret
